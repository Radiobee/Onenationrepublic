<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>One Nation Republic | Hub &amp; Links</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-deep: #07090e;
      --bg-surface: #0f131c;
      --bg-elevated: #151b26;
      --border-subtle: #222b3d;
      --gold: #c5a059;
      --gold-soft: rgba(197, 160, 89, 0.14);
      --gold-border: rgba(197, 160, 89, 0.35);
      --text-primary: #f1f5f9;
      --text-secondary: #cbd5e1;
      --text-muted: #94a3b8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-deep);
      background-image: radial-gradient(circle at 50% 0%, #151c2c 0%, var(--bg-deep) 65%);
      color: var(--text-primary);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px 20px;
      -webkit-font-smoothing: antialiased;
    }

    .hub-container {
      width: 100%;
      max-width: 540px;
      text-align: center;
    }

    .logo-img {
      width: 140px;
      height: 140px;
      object-fit: cover;
      border-radius: 50%;
      border: 3px solid var(--gold-border);
      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.8);
      margin-bottom: 24px;
    }

    .eyebrow {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--gold);
      background: var(--gold-soft);
      border: 1px solid var(--gold-border);
      padding: 5px 14px;
      border-radius: 4px;
      margin-bottom: 16px;
    }

    h1 {
      font-family: 'Cinzel', Georgia, serif;
      font-size: 1.8rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: var(--text-primary);
      margin-bottom: 8px;
    }

    .subtitle {
      font-size: 0.95rem;
      color: var(--text-muted);
      margin-bottom: 36px;
    }

    .links-list {
      display: flex;
      flex-direction: column;
      gap: 16px;
      width: 100%;
    }

    .link-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-left: 3px solid var(--gold);
      color: var(--text-primary);
      text-decoration: none;
      padding: 18px 24px;
      border-radius: 10px;
      transition: all 0.25s ease;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    }

    .link-btn:hover {
      background: var(--bg-elevated);
      border-color: var(--gold);
      transform: translateY(-2px);
      box-shadow: 0 12px 32px rgba(197, 160, 89, 0.15);
    }

    .link-title {
      font-family: 'Cinzel', Georgia, serif;
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 4px;
      letter-spacing: 0.03em;
    }

    .link-desc {
      font-size: 0.82rem;
      color: var(--text-muted);
    }

    .footer-note {
      margin-top: 48px;
      font-size: 0.78rem;
      color: var(--text-muted);
      letter-spacing: 0.03em;
    }
  </style>
</head>
<body>

  <div class="hub-container">
    <img src="One%20Nation%20Logo.jpg" alt="One Nation Emblem" class="logo-img" />
    <span class="eyebrow">Structure • Unity • Sovereignty</span>
    <h1>ONE NATION REPUBLIC</h1>
    <p class="subtitle">Official Portals &amp; Community Resources</p>

    <div class="links-list">
      <!-- MIGHTY APP 30 DAYS FREE COMMUNITY LINK -->
      <a href="https://one-nation-info.mn.co/plans/2003708?bundle_token=3a23848fa6f487fae4ee3cda4fb9934a&utm_source=manual" class="link-btn" target="_blank" rel="noopener noreferrer">
        <span class="link-title">Enter the One Nation Community</span>
        <span class="link-desc">Get 30 Days Free on the Official Mighty App</span>
      </a>

      <!-- ADD ADDITIONAL CUSTOM LINKS HERE AS NEEDED -->
      <!-- Example format:
      <a href="YOUR_URL_HERE" class="link-btn" target="_blank" rel="noopener noreferrer">
        <span class="link-title">Portal Title</span>
        <span class="link-desc">Brief description of resource</span>
      </a>
      -->
    </div>

    <div class="footer-note">
      &copy; 2026 One Nation Republic. All Rights Reserved.
    </div>
  </div>

</body>
</html>
